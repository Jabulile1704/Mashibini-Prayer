migrate_working_dir/

# IntelliJ related
*.iml
*.ipr
*.iws
.idea/

# The .vscode folder contains launch configuration and tasks you configure in
# VS Code which you may wish to be included in version control, so this line
# is commented out by default.
#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/coverage/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# Widget Preview related
.widget_preview/

# Rules tests pull a node_modules tree; the lockfile is what we version.
test/rules/node_modules/

# Generated by tool/emit_rules_fixture.dart, before the rules tests run.
#
# Deliberately not committed. A checked-in copy of a generated document goes
# stale silently, which is the exact failure this fixture exists to fix — the
# rules and the app agreeing on paper and not in fact.
test/rules/fixtures/

# Built artefacts, which belong on a GitHub Release and not in the history.
#
# A 52MB APK was committed here on 4 November while testing
# `tool/apk_signing_key.dart` against a real release — swept in by a
# `git add -A` that should have been a named path. Removing it from the
# tree does not remove it from the history; this stops the next one.
dist/
*.apk
*.aab
*.ipa
